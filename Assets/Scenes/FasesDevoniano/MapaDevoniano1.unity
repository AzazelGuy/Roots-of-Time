    - target: {fileID: 2300411002643591179, guid: b4d1bb2a151a9c443a624c469d1fcc7b, type: 3}
      propertyPath: dialoguePages.Array.data[1].text
      value: "\"Debaixo de sua boca ele contem uma arma de defesa pessoa, mesmo de
        curta distancia, sua mordida \xE9 mais doque capaz de MACHUCAR quem esteja
        ao redor\""
      objectReference: {fileID: 0}
    - target: {fileID: 2300411002643591179, guid: b4d1bb2a151a9c443a624c469d1fcc7b, type: 3}
